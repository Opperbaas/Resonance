@{
    ViewData["Title"] = "Spotify Playback";
    var spotifyAccessToken = ViewBag.SpotifyAccessToken as string ?? string.Empty;
    var trackUri = ViewBag.TrackUri as string ?? string.Empty;
}

<h2>Spotify Web Playback</h2>

@if (string.IsNullOrEmpty(spotifyAccessToken))
{
    <div class="alert alert-warning">Spotify is not connected. <a href="/spotify/connect">Connect with Spotify</a> first.</div>
}
else
{
    <div id="player-status" class="alert alert-info">Loading Spotify player...</div>
    <div id="player-controls" class="d-none">
        <button id="play-button" class="btn btn-success">Play track</button>
        <button id="pause-button" class="btn btn-secondary">Pause</button>
    </div>

    <div class="mt-3">
        <p><strong>Track URI:</strong> @trackUri</p>
        <p>Use the buttons above once the Spotify player is ready.</p>
        <p class="text-muted">If the player keeps loading, make sure you are logged in to Spotify Premium in this browser.</p>
    </div>

    <script>
        const spotifyAccessToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(spotifyAccessToken));
        const trackUri = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trackUri));
        let player;
        let deviceId = null;
        const playerStatusElement = document.getElementById('player-status');
        let playerInitializationTimeout;

        function setPlayerStatus(message) {
            if (playerStatusElement) {
                playerStatusElement.innerText = message;
            }
        }

        window.onSpotifyWebPlaybackSDKReady = () => {
            player = new Spotify.Player({
                name: 'Resonance Web Player',
                getOAuthToken: cb => { cb(spotifyAccessToken); },
                volume: 0.8
            });

            player.addListener('ready', ({ device_id }) => {
                clearTimeout(playerInitializationTimeout);
                deviceId = device_id;
                setPlayerStatus('Spotify player is ready.');
                document.getElementById('player-controls')?.classList.remove('d-none');
            });

            player.addListener('not_ready', ({ device_id }) => {
                setPlayerStatus('Spotify device went offline.');
            });

            player.addListener('initialization_error', ({ message }) => {
                clearTimeout(playerInitializationTimeout);
                setPlayerStatus('Initialization error: ' + message);
            });

            player.addListener('authentication_error', ({ message }) => {
                clearTimeout(playerInitializationTimeout);
                setPlayerStatus('Authentication error: ' + message + '. Please reconnect your Spotify account.');
            });

            player.addListener('account_error', ({ message }) => {
                clearTimeout(playerInitializationTimeout);
                setPlayerStatus('Account error: ' + message + '. Spotify Premium is required for web playback.');
            });

            player.addListener('playback_error', ({ message }) => {
                setPlayerStatus('Playback error: ' + message);
            });

            player.connect();

            playerInitializationTimeout = setTimeout(() => {
                if (!deviceId) {
                    setPlayerStatus('Spotify player is still loading. Ensure you are logged in to Spotify Premium and that the browser supports Spotify Web Playback.');
                }
            }, 15000);
        };

        async function startPlayback() {
            if (!deviceId) {
                alert('Spotify device is not ready yet.');
                return;
            }

            if (!trackUri || trackUri.trim() === '') {
                setPlayerStatus('No Spotify track is configured for playback. Go back and open via the Spotify playback button on a track.');
                return;
            }

            const response = await fetch('/spotify/play', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ deviceId, trackUri })
            });

            if (response.ok) {
                setPlayerStatus('Playback started on Spotify.');
            } else {
                const text = await response.text();
                setPlayerStatus('Playback failed: ' + response.status + ' ' + text);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('play-button')?.addEventListener('click', startPlayback);
            document.getElementById('pause-button')?.addEventListener('click', async () => {
                if (!player) return;
                await player.pause();
            });
        });
    </script>
    <script src="https://sdk.scdn.co/spotify-player.js"></script>
}

<p class="mt-3"><a asp-controller="Library" asp-action="Index" class="btn btn-secondary">Back to library</a></p>
