@model IEnumerable<Resonance.BusinessLogicLayer.DTOs.TrackDto>
@{
    ViewData["Title"] = "Library";
}

<h2>Your Library</h2>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@{
    var searchProvider = ViewBag.SearchProvider as string ?? "Spotify";
    var spotifySelected = searchProvider == "YouTube" ? string.Empty : "selected";
    var youtubeSelected = searchProvider == "YouTube" ? "selected" : string.Empty;
    var moodTypes = (IEnumerable<Resonance.BusinessLogicLayer.DTOs.MoodTypeDto>)(ViewBag.MoodTypes ?? Enumerable.Empty<Resonance.BusinessLogicLayer.DTOs.MoodTypeDto>());
    var moodTypeMap = moodTypes.ToDictionary(mt => mt.MoodTypeID, mt => mt);
    var trackMoodMap = (Dictionary<long, Resonance.BusinessLogicLayer.DTOs.MoodEntryDto>)(ViewBag.TrackMoodMap ?? new Dictionary<long, Resonance.BusinessLogicLayer.DTOs.MoodEntryDto>());
}
<form asp-action="Search" asp-controller="Library" method="post" class="mb-4">
    <div class="input-group">
        <select name="provider" class="form-select" style="max-width: 180px;">
            <option value="Spotify" selected="@spotifySelected">Spotify</option>
            <option value="YouTube" selected="@youtubeSelected">YouTube</option>
        </select>
        <input type="text" name="query" value="@(ViewBag.SearchQuery ?? string.Empty)" class="form-control" placeholder="Search tracks..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>
@if (!(ViewBag.SpotifyConnected ?? false))
{
    <div class="alert alert-warning">Spotify is not connected. <a href="/spotify/connect" class="alert-link">Connect with Spotify</a> for full playback.</div>
}
else
{
    <div class="alert alert-success">Spotify is connected. Full playback is available for Spotify tracks.</div>
}
@if (ViewBag.SearchResults != null)
{
    <h4>Spotify Search Results</h4>
    <table class="table table-bordered">
        <thead>
            <tr><th>Title</th><th>Artist</th><th>Album</th><th>Preview</th><th>Add</th></tr>
        </thead>
        <tbody>
        @foreach(var result in (IEnumerable<Resonance.BusinessLogicLayer.DTOs.TrackDto>)ViewBag.SearchResults)
        {
            <tr>
                <td>@result.Title</td>
                <td>@result.ArtistName</td>
                <td>@result.Album</td>
                <td>
                    @if (result.Provider == "YouTube")
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Play" asp-route-provider="YouTube" asp-route-providerTrackKey="@result.ProviderTrackKey">Open YouTube</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(result.PreviewUrl))
                    {
                        <audio controls src="@result.PreviewUrl"></audio>
                    }
                    else
                    {
                        <span>No preview</span>
                    }
                </td>
                <td>
                    <form asp-action="Add" asp-controller="Library" method="post" class="d-inline">
                        <input type="hidden" name="Provider" value="@result.Provider" />
                        <input type="hidden" name="ProviderTrackKey" value="@result.ProviderTrackKey" />
                        <input type="hidden" name="Title" value="@result.Title" />
                        <input type="hidden" name="ArtistID" value="@result.ArtistID" />
                        <input type="hidden" name="ArtistName" value="@result.ArtistName" />
                        <input type="hidden" name="Album" value="@result.Album" />
                        <input type="hidden" name="DurationMs" value="@result.DurationMs" />
                        <input type="hidden" name="ReleaseDate" value="@(result.ReleaseDate.ToString("yyyy-MM-dd"))" />
                        <button type="submit" class="btn btn-success btn-sm">Add to library</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
<table class="table">
    <thead>
        <tr><th>Title</th><th>Artist</th><th>Provider</th><th>Album</th><th>Duration</th><th>Release date</th><th>Play</th><th>Mood</th></tr>
    </thead>
    <tbody>
    @foreach(var s in Model ?? Enumerable.Empty<Resonance.BusinessLogicLayer.DTOs.TrackDto>())
    {
        <tr>
            <td>@s.Title</td>
            <td>@(string.IsNullOrWhiteSpace(s.ArtistName) ? s.ArtistID.ToString() : s.ArtistName)</td>
            <td>@s.Provider</td>
            <td>@s.Album</td>
            <td>@s.DurationMs ms</td>
            <td>@s.ReleaseDate.ToString("yyyy-MM-dd")</td>
            <td>
                @if (s.Provider == "Spotify")
                {
                    <a class="btn btn-outline-primary btn-sm" asp-action="Play" asp-route-provider="Spotify" asp-route-providerTrackKey="@s.ProviderTrackKey">Play</a>
                    @if ((bool)(ViewBag.SpotifyConnected ?? false))
                    {
                        <a class="btn btn-outline-success btn-sm ms-1" asp-controller="Spotify" asp-action="Playback" asp-route-trackUri="spotify:track:@s.ProviderTrackKey">Full Spotify</a>
                    }
                }
                else if (s.Provider == "YouTube")
                {
                    <a class="btn btn-outline-primary btn-sm" asp-action="Play" asp-route-provider="YouTube" asp-route-providerTrackKey="@s.ProviderTrackKey">Play</a>
                }
            </td>
            <td>
                @{ var currentMood = trackMoodMap.TryGetValue(s.TrackID, out var moodEntry) ? moodEntry : null; }
                <form asp-action="AddMood" asp-controller="Library" method="post" class="d-flex flex-wrap gap-1 align-items-center">
                    <input type="hidden" name="trackId" value="@s.TrackID" />
                    <label class="visually-hidden" for="moodTypeId-@s.TrackID">Choose mood</label>
                    <select id="moodTypeId-@s.TrackID" name="moodTypeId" class="form-select form-select-sm" style="min-width: 140px;">
                        @foreach (var mood in moodTypes)
                        {
                            var isSelected = currentMood != null && currentMood.MoodTypeID == mood.MoodTypeID;
                            if (isSelected)
                            {
                                <option value="@mood.MoodTypeID" selected="selected">@((mood.Emoji ?? string.Empty) + (string.IsNullOrWhiteSpace(mood.Emoji) ? string.Empty : " ") + mood.Label)</option>
                            }
                            else
                            {
                                <option value="@mood.MoodTypeID">@((mood.Emoji ?? string.Empty) + (string.IsNullOrWhiteSpace(mood.Emoji) ? string.Empty : " ") + mood.Label)</option>
                            }
                        }
                    </select>
                    <input type="text" name="note" value="@(currentMood?.Note ?? string.Empty)" class="form-control form-control-sm" placeholder="Optional note (why this mood?)" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Save mood</button>
                </form>
                @if (currentMood != null)
                {
                    var moodLabel = moodTypeMap.TryGetValue(currentMood.MoodTypeID, out var mt) ? mt.Label : $"Mood {currentMood.MoodTypeID}";
                    <div class="small text-muted mt-1">Huidige mood: @moodLabel @if(!string.IsNullOrWhiteSpace(currentMood.Note)) { <span>- @currentMood.Note</span> }</div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<h4>Add a track</h4>
<form asp-action="Add" asp-controller="Library" method="post">
    <div class="form-group">
        <label>Provider</label>
        <input name="Provider" class="form-control" />
    </div>
    <div class="form-group">
        <label>Provider Track Key</label>
        <input name="ProviderTrackKey" class="form-control" />
    </div>
    <div class="form-group">
        <label>Title</label>
        <input name="Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Artist Name</label>
        <input name="ArtistName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Artist ID</label>
        <input name="ArtistID" type="number" class="form-control" />
    </div>
    <div class="form-group">
        <label>Album</label>
        <input name="Album" class="form-control" />
    </div>
    <div class="form-group">
        <label>Duration (ms)</label>
        <input name="DurationMs" type="number" class="form-control" />
    </div>
    <div class="form-group">
        <label>Release Date</label>
        <input name="ReleaseDate" type="date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Add</button>
</form>